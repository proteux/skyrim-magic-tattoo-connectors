    {
      "id": "bounty",
      "label": "Bounty in this hold",
      "description": "Triggers while the player has a bounty of at least {param1} gold in the hold they are in.",
      "param": { "label": "At least", "min": 1, "max": 5000, "default": 40, "format": "{0} gold" }
    },
    {
      "id": "wanted",
      "label": "Wanted anywhere",
      "description": "Triggers while the player has a bounty of at least {param1} gold in any hold, Solstheim included.",
      "param": { "label": "At least", "min": 1, "max": 5000, "default": 1, "format": "{0} gold" }
    },
    {
      "id": "hidden",
      "label": "Hidden",
      "description": "Triggers while the actor is sneaking and nobody nearby has detected them. The player's followers do not count."
    },
    {
      "id": "sitting",
      "label": "Sitting",
      "description": "Triggers while the actor is sitting in a chair, bench, or other furniture."
    },
    {
      "id": "sleeping",
      "label": "Sleeping",
      "description": "Triggers while the actor is asleep."
    },
    {
      "id": "crafting",
      "label": "At a crafting station",
      "description": "Triggers while the actor is using {param1}.",
      "param": {
        "label": "Station",
        "default": "any",
        "menu": [
          { "id": "any", "label": "Any crafting station" },
          { "id": "forge", "label": "A forge" },
          { "id": "workbench", "label": "A workbench" },
          { "id": "grindstone", "label": "A grindstone" },
          { "id": "smelter", "label": "A smelter" },
          { "id": "tanning_rack", "label": "A tanning rack" },
          { "id": "cooking", "label": "A cooking pot or spit" },
          { "id": "alchemy", "label": "An alchemy lab" },
          { "id": "enchanting", "label": "An arcane enchanter" }
        ]
      }
    },
    {
      "id": "diseased",
      "label": "Diseased",
      "description": "Triggers while the actor has any disease."
    },
    {
      "id": "kill.recent",
      "label": "Just made a kill",
      "description": "Triggers for {param1} seconds after the player kills anyone or anything.",
      "param": { "label": "Seconds", "min": 1, "max": 120, "default": 10, "format": "{0} s" }
    },
    {
      "id": "levelup.recent",
      "label": "Just leveled up",
      "description": "Triggers for {param1} seconds after the actor gains a level.",
      "param": { "label": "Seconds", "min": 1, "max": 600, "default": 30, "format": "{0} s" }
    }
  ],
  "effects": [
    {
      "id": "vision.night",
      "label": "Night vision",
      "description": "While shown on the player, they see in the dark as with Night Eye."
    },
    {
      "id": "shout.recovery",
      "label": "Shout recovery",
      "description": "While shown, the actor's shout cooldowns last {param1}% as long as usual.",
      "param1": { "label": "Cooldown", "min": 10, "max": 300, "step": 10, "default": 50, "format": "{0}%" }
    },
    {
      "id": "disease.cure",
      "label": "Cure disease",
      "kind": "burst",
      "description": "When shown, every disease the actor has is cured."
    },
    {
      "id": "rested",
      "label": "Rested bonus",
      "description": "While shown, the actor keeps {param1}. A bonus they already had when the tattoo appeared stays when it goes.",
      "param1": {
        "label": "Bonus",
        "default": "well_rested",
        "menu": [
          { "id": "rested", "label": "Rested" },
          { "id": "well_rested", "label": "Well Rested" },
          { "id": "lovers_comfort", "label": "Lover's Comfort" }
        ]
      }
    },
    {
      "id": "mood",
      "label": "Facial mood",
      "description": "While shown, the actor's face holds a {param1} expression at {param2}% strength.",
      "param1": {
        "label": "Mood",
        "default": "happy",
        "menu": [
          { "id": "neutral", "label": "Neutral" },
          { "id": "angry", "label": "Angry" },
          { "id": "fearful", "label": "Fearful" },
          { "id": "happy", "label": "Happy" },
          { "id": "sad", "label": "Sad" },
          { "id": "surprised", "label": "Surprised" },
          { "id": "puzzled", "label": "Puzzled" },
          { "id": "disgusted", "label": "Disgusted" }
        ]
      },
      "param2": { "label": "Strength", "min": 0, "max": 100, "step": 5, "default": 75, "format": "{0}%" }
    },
    {
      "id": "calm",
      "label": "Calm enemies",
      "kind": "burst",
      "description": "When shown, everyone within {param1} metres who is hostile to or fighting the actor stops fighting. Enemies that are always hostile may attack again.",
      "param1": { "label": "Radius", "min": 5, "max": 100, "step": 5, "default": 20, "format": "{0} m" }
    },
    {
      "id": "fall.nodamage",
      "label": "No fall damage",
      "description": "While shown on the player, falling does them no harm."
    },
    {
      "id": "weather",
      "label": "Change the weather",
      "kind": "burst",
      "description": "When shown on the player, the weather turns {param1}. It changes again on its own later.",
      "param1": {
        "label": "Weather",
        "default": "clear",
        "menu": [
          { "id": "clear", "label": "Clear" },
          { "id": "cloudy", "label": "Cloudy" },
          { "id": "fog", "label": "Foggy" },
          { "id": "rain", "label": "Rainy" },
          { "id": "storm", "label": "Thunderstorm" },
          { "id": "snow", "label": "Snowy" },
          { "id": "blizzard", "label": "Blizzard" }
        ]
      }
    }
